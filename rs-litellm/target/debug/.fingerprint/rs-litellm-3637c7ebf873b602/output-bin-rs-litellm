lf>`.\n"},"level":"error","spans":[{"file_name":"src/router.rs","byte_start":3741,"byte_end":3766,"line_start":115,"line_end":115,"column_start":23,"column_end":48,"is_primary":true,"text":[{"text":"        let counter = self.counters.get(model)?;","highlight_start":23,"highlight_end":48}],"label":"`Provider` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"src/router.rs","byte_start":3741,"byte_end":3766,"line_start":115,"line_end":115,"column_start":23,"column_end":48,"is_primary":false,"text":[{"text":"        let counter = self.counters.get(model)?;","highlight_start":23,"highlight_end":48}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null},"macro_decl_name":"desugaring of operator `?`","def_site_span":{"file_name":"src/main.rs","byte_start":0,"byte_end":0,"line_start":1,"line_end":1,"column_start":1,"column_end":1,"is_primary":false,"text":[],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null}}}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"src/providers/mod.rs","byte_start":507,"byte_end":515,"line_start":18,"line_end":18,"column_start":11,"column_end":19,"is_primary":false,"text":[{"text":"pub trait Provider: Send + Sync {","highlight_start":11,"highlight_end":19}],"label":"this trait is not dyn compatible...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/providers/mod.rs","byte_start":593,"byte_end":608,"line_start":20,"line_end":20,"column_start":14,"column_end":29,"is_primary":true,"text":[{"text":"    async fn chat_completion(","highlight_start":14,"highlight_end":29}],"label":"...because method `chat_completion` is `async`","suggested_replacement":null,"sugg