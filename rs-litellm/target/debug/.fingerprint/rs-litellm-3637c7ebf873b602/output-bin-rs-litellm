lf>`.\n"},"level":"error","spans":[{"file_name":"src/router.rs","byte_start":6292,"byte_end":6307,"line_start":181,"line_end":181,"column_start":63,"column_end":78,"is_primary":true,"text":[{"text":"                        if let Some((entry, provider)) = self.next_deployment(fb_model) {","highlight_start":63,"highlight_end":78}],"label":"`Provider` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"src/providers/mod.rs","byte_start":507,"byte_end":515,"line_start":18,"line_end":18,"column_start":11,"column_end":19,"is_primary":false,"text":[{"text":"pub trait Provider: Send + Sync {","highlight_start":11,"highlight_end":19}],"label":"this trait is not dyn compatible...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/providers/mod.rs","byte_start":593,"byte_end":608,"line_start":20,"line_end":20,"column_start":14,"column_end":29,"is_primary":true,"text":[{"text":"    async fn chat_completion(","highlight_start":14,"highlight_end":29}],"label":"...because method `chat_completion` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/providers/mod.rs","byte_start":838,"byte_end":860,"line_start":27,"line_end":27,"column_start":14,"column_end":36,"is_primary":true,"text":[{"text":"    async fn chat_completion_stream(","highlight_start":14,"highlight_end":36}],"label":"...because method `chat_completion_stream` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/providers/mod.rs","byte_start":1041,"byte_end":1050,"line_start":34,"line_end":34,"column_start":14,"column_end":23,"is_primary":true,"text":[{"text":"    asy